{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-os.dev/schemas/execution/execution-plan.schema.json",
  "title": "Engineering OS Execution Plan",
  "type": "object",
  "additionalProperties": true,
  "required": ["kind", "id", "project_id", "intent_summary", "capability_ids", "status", "revision"],
  "properties": {
    "kind": { "const": "execution_plan" },
    "id": { "type": "string", "pattern": "^eos\\.plan\\.[a-z][a-z0-9-]*$" },
    "project_id": { "type": "string", "minLength": 1 },
    "intent_summary": { "type": "string", "minLength": 1 },
    "capability_ids": { "type": "array", "items": { "type": "string" } },
    "insufficient_coverage": { "type": "array" },
    "artifact_ids": { "type": "array", "items": { "type": "string" } },
    "task_ids": { "type": "array", "items": { "type": "string" } },
    "gate_ids": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array" },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "superseded", "cancelled"]
    },
    "revision": { "type": "integer", "minimum": 1 }
  }
}
