{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-os.dev/schemas/execution/plan.schema.json",
  "title": "Engineering OS Execution Plan",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "project_id", "intent_summary", "status", "revision"],
  "properties": {
    "id": { "type": "string", "pattern": "^eos\\.plan\\.[a-z][a-z0-9-]*$" },
    "project_id": { "type": "string" },
    "intent_summary": { "type": "string", "minLength": 1 },
    "capability_ids": { "type": "array", "items": { "type": "string" } },
    "insufficient_coverage": { "type": "array" },
    "artifact_ids": { "type": "array", "items": { "type": "string" } },
    "task_ids": { "type": "array", "items": { "type": "string" } },
    "gate_ids": { "type": "array", "items": { "type": "string" } },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "from", "to"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "task_depends_on_task",
              "task_requires_artifact",
              "gate_requires_artifact",
              "gate_requires_task",
              "milestone_requires_gate"
            ]
          },
          "from": { "type": "string" },
          "to": { "type": "string" }
        }
      }
    },
    "status": { "type": "string" },
    "revision": { "type": "integer", "minimum": 1 }
  }
}
