{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-os.dev/schemas/execution/task.schema.json",
  "title": "Engineering OS Task",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "title", "description", "objective", "project_id", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^eos\\.task\\.[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "pattern": "^eos\\.project\\.[a-z][a-z0-9-]*$" },
    "capability_ids": { "type": "array", "items": { "type": "string" } },
    "role_ids": { "type": "array", "items": { "type": "string" } },
    "input_artifact_ids": { "type": "array", "items": { "type": "string" } },
    "output_artifact_ids": { "type": "array", "items": { "type": "string" } },
    "depends_on_task_ids": { "type": "array", "items": { "type": "string" } },
    "status": {
      "type": "string",
      "enum": ["pending", "ready", "in_progress", "blocked", "completed", "failed", "cancelled"]
    },
    "priority": { "type": "string" },
    "risk": { "type": "string" },
    "owner": { "type": "string" }
  }
}
