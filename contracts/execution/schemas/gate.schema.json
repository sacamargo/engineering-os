{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-os.dev/schemas/execution/gate.schema.json",
  "title": "Engineering OS Validation Gate",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "title", "project_id", "condition", "required_evidence", "result"],
  "properties": {
    "id": { "type": "string", "pattern": "^eos\\.gate\\.[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string" },
    "condition": { "type": "string", "minLength": 1 },
    "required_evidence": { "type": "array", "minItems": 1 },
    "result": { "type": "string", "enum": ["pending", "passed", "failed", "waived"] },
    "approver": { "type": "string" },
    "on_failure": { "type": "string" }
  }
}
